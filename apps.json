{
  "bsr": {
    "name": "BSR Manager App",
    "repo": "evanreppeto/clone-BS-migration",
    "short": "BSR",
    "checks": ["pnpm typecheck", "pnpm test", "pnpm lint"],
    "buildCommand": "pnpm build",
    "buildTriggers": ["package.json", "pnpm-lock.yaml", "next.config.*", "middleware.ts", "**/route.ts"],
    "sensitive": [
      "middleware.ts", "lib/supabase/middleware.ts", "app/auth/**", "lib/supabase/admin.ts",
      "**/*quickbooks*", "**/*quickbooks*/**", "**/*invoice*", "**/*invoice*/**",
      "supabase/migrations/**", "app/portal/**", "components/portal/**",
      "app/api/cron/payroll-approval/**", "lib/payroll-period*", ".github/workflows/**"
    ],
    "feedback": { "team": "BSR", "labelId": "de5bbac3-396c-4a26-bb4e-91d9ba0d60a7" },
    "devUrl": "https://dev.bigshouldersmanager.com",
    "prodUrl": "https://www.bigshouldersmanager.com",
    "viewports": [
      {
        "name": "desktop",
        "width": 1280,
        "height": 800,
        "isMobile": false
      },
      {
        "name": "phone",
        "width": 390,
        "height": 844,
        "isMobile": true
      }
    ],
    "login": {
      "path": "/auth/login",
      "emailSelector": "input[type=\"email\"]",
      "passwordSelector": "input[type=\"password\"]",
      "submitSelector": "form button[type=\"submit\"]"
    },
    "credsEnv": {
      "email": "BSR_QA_EMAIL",
      "password": "BSR_QA_PASSWORD"
    },
    "safety": [
      "Dev has its own database: creating/editing/deleting test records is fine.",
      "Never send email or SMS, never push to QuickBooks, never trigger payroll or invoice reminders — dev may still be wired to real Resend, Quo, and QuickBooks.",
      "Assume dev still has live Resend, Quo, and QuickBooks keys until Evan confirms otherwise: even an ordinary save can email or text real people, so avoid saves that notify customers, crews, or vendors unless the ticket requires it."
    ],
    "qaEmail": "evan.reppeto5928+bsrqa@gmail.com",
    "deployProbe": {
      "path": "/sw.js",
      "pattern": "[0-9a-f]{12}"
    },
    "ignoreMissingResources": [
      "/avatars/",
      "/api/streetview"
    ],
    "smokeRoutes": [
      "/",
      "/projects",
      "/schedule",
      "/time-tracking",
      "/clients",
      "/equipment"
    ],
    "consoleBaseline": [
      "supabase.co/realtime/v1/websocket"
    ]
  },
  "arc": {
    "name": "Arc Studio",
    "repo": "evanreppeto/arc-studio",
    "short": "Arc",
    "checks": [
      "pnpm typecheck",
      "pnpm lint",
      "pnpm --filter ./apps/arc-runner typecheck",
      "pnpm --filter ./apps/arc-runner test",
      "pnpm --filter ./packages/arc-connector test",
      "pnpm test"
    ],
    "buildCommand": "ARC_CI_SKIP_BUILD_TYPECHECK=1 pnpm build",
    "buildTriggers": ["package.json", "**/package.json", "pnpm-lock.yaml", "next.config.*", "src/proxy.ts", "middleware.ts", "**/route.ts"],
    "sensitive": [
      "src/proxy.ts", "src/lib/auth/**", "src/app/api/auth/**", "src/app/login/**",
      "**/*billing*", "**/*billing*/**", "**/*stripe*", "**/*stripe*/**", "**/*payment*", "**/*payment*/**",
      "supabase/migrations/**", "src/lib/vault/**", "src/app/api/cron/**",
      "src/app/v3/_actions/launch.ts", "src/lib/campaigns/launch*", "src/lib/campaigns/external-send*",
      "src/lib/automations/delivery.ts", "**/*dispatch*", "**/*dispatch*/**", ".github/workflows/**",
      "src/lib/approvals/**", "src/lib/campaigns/decisions.ts", "src/lib/campaigns/planned-send*",
      "src/lib/connectors/**", "src/lib/connections/**", "src/lib/integrations/**", "src/lib/supabase/**", "vercel.json"
    ],
    "devUrl": "https://dev.arc-studio.ai",
    "prodUrl": "https://arc-studio.ai",
    "viewports": [
      {
        "name": "desktop",
        "width": 1280,
        "height": 800,
        "isMobile": false
      }
    ],
    "login": {
      "path": "/login",
      "emailSelector": "#email",
      "passwordSelector": "#password",
      "submitSelector": "form[action=\"/api/auth/sign-in\"] button[type=\"submit\"]"
    },
    "credsEnv": {
      "email": "ARC_QA_EMAIL",
      "password": "ARC_QA_PASSWORD"
    },
    "testWorkspace": "Test Workspace",
    "safety": [
      "Dev SHARES THE PRODUCTION DATABASE. Act only inside the test workspace; if the workspace switcher shows any other workspace as active, stop and mark the ticket blocked.",
      "Never approve-and-launch, send, or publish anything outbound (campaign launch, external send, email, social post). Drafting and approving inside the test workspace is fine.",
      "Never set schedules or send windows, never activate or enable automations, never connect, authorize, or reconnect connectors/integrations — prod background jobs on the shared database (scheduled dispatch every minute, automations every 5 minutes) would act on them for real."
    ],
    "qaEmail": "evan.reppeto5928+arcqa@gmail.com",
    "testWorkspaceSlug": "test-workspace",
    "deployProbe": {
      "path": "/login",
      "pattern": "[0-9a-f]{40}"
    },
    "smokeRoutes": [
      "/v3",
      "/v3/approvals",
      "/v3/campaigns",
      "/v3/records",
      "/v3/studio",
      "/v3/connections"
    ],
    "consoleBaseline": []
  }
}
